# Local overrides for the Assistant. You normally don't need this file:
# `pnpm dev:vercel` pulls everything from the linked Vercel project.
# To run plain `pnpm dev` instead, `pnpm exec vercel env pull .env.local`.

# Vercel AI Gateway auth. Injected automatically on Vercel and by `vercel dev`.
# VERCEL_OIDC_TOKEN=

# Optional: swap the model without a code change (see lib/assistant/model.ts).
# CHAT_MODEL=anthropic/claude-haiku-4.5

# Neon Postgres for Conversation logs, added by the Neon integration. Without
# it the Assistant still works; it just doesn't log.
# DATABASE_URL=

# Protects the daily log-purge cron. Set any long random string in Vercel.
# CRON_SECRET=
